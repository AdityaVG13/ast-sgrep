{
  "name": "pi-ast-sgrep",
  "version": "1.3.2",
  "description": "Pi extension for ast-sgrep with Code Mode (JS sandbox) execution",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "ast",
    "code-search",
    "semantic-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdityaVG13/ast-sgrep.git",
    "directory": "packages/pi/extension"
  },
  "homepage": "https://github.com/AdityaVG13/ast-sgrep#readme",
  "files": [
    "dist",
    "native",
    "skills",
    "assets",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "image": "./assets/preview.png"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "cargo build -p ast-sgrep-codemode-napi --release && node ./scripts/copy-native.mjs",
    "test": "ASGREP_CODEMODE_BACKEND=cli node --import tsx --test test/codemode.test.ts test/commands.test.ts test/runtime.test.ts test/security.test.ts test/session-pool.test.ts test/skill-workflow.test.ts test/tools.test.ts",
    "test:native": "node --import tsx --test test/native-inprocess.test.ts",
    "test:all": "npm test && npm run test:native",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "ast-sgrep": "1.3.2",
    "typebox": "^1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6 <1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
