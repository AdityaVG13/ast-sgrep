{
  "name": "ast-sgrep-workspace",
  "version": "2.6.0",
  "private": true,
  "workspaces": [
    "packages/pi/extension",
    "packages/pi/launcher"
  ],
  "scripts": {
    "check:agent-plugin": "node packages/agent-plugin/scripts/check-plugin.mjs",
    "check:pi-contract": "node packages/pi/scripts/check-contract.mjs",
    "check:pi-dist": "npm run build --workspace pi-ast-sgrep && test -z \"$(git status --porcelain -- packages/pi/extension/dist)\"",
    "check:pi-release": "node packages/pi/scripts/check-native-workflow.mjs",
    "pack:pi-release": "node packages/pi/scripts/release-acceptance.mjs pack",
    "test:pi-release-gate": "node packages/pi/scripts/release-acceptance.mjs self-test",
    "test:pi-e2e": "node packages/pi/scripts/release-gate-e2e.mjs",
    "release:preflight": "node packages/pi/scripts/release-preflight.mjs",
    "release:prepare": "node packages/pi/scripts/release-prepare.mjs",
    "release:e2e-linux": "node packages/pi/scripts/release-e2e-linux.mjs",
    "release:fallback": "node packages/pi/scripts/release-fallback.mjs",
    "release:verify": "node packages/pi/scripts/release-fallback.mjs --verify-only",
    "publish:pi-extension": "node packages/pi/scripts/publish-extension.mjs",
    "release": "node packages/pi/scripts/release.mjs"
  }
}
